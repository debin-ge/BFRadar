# 黑五雷达（BFRadar）配置示例：cp .env.example .env 后按需修改。
# 留空即使用默认值（括号内）；变量说明见《需求与方案说明》第 18 节。真实环境变量优先于本文件。

# ---- 站点
SITE_URL=                     # 生产填正式域名（http://127.0.0.1:8000）
SITE_NAME_ZH=                 # （黑五雷达）
SITE_NAME_EN=                 # （BFRadar）
SITE_FULLNAME_EN=             # 英文 <title> 后缀与 OG 站名（BlackFridayRadar）
CONTACT_EMAIL=                # 关于页的联系与内容移除邮箱，也写进默认 User-Agent（上线前必填）
HOST=                         # （0.0.0.0）
PORT=                         # （8000）
DB_PATH=                      # 相对路径以项目根为基准（data/radar.db）

# ---- 采集
SOURCES=                      # 启用的源，逗号分隔（lowendtalk,lowendspirit,lowendbox,nodeseek,reddit,telegram,official,
                              # v2ex,nodeloc,hostingdiscussion）
# 每源间隔（分钟）：INTERVAL_<SOURCE> 为常态，INTERVAL_<SOURCE>_BF 为黑五周
# 默认 LET 60/30、LES 60/60、LEB 60/60、NodeSeek 5/3（D24）、Reddit 20/10（三个入口轮转，D83）、Telegram 30/10（D81）、
# 官网活动页 official 240/120（D84）、V2EX / NodeLoc / HostingDiscussion 各 60/30（D88）
INTERVAL_NODESEEK=
INTERVAL_NODESEEK_BF=
BF_WEEK_START=                # 黑五周档位开始（2026-11-24）
BF_WEEK_END=                  # 黑五周档位结束（2026-12-01）
SEASON_START=                 # 本季下限，scope=bf/promo 只含此日之后发布的记录（2026-10-01，D23）
TODAY=                        # 固定"今天"（YYYY-MM-DD，测试与演示用）：判断活动是否结束、还剩几天以它为准；留空用真实日期（D70）
REDDIT_SUBREDDITS=            # 社区入口合并的版块（VPS,webhosting,hetzner,Hosting,HostingReport,SelfHosting，D83）
LES_CATEGORIES=               # LES 分类 slug（offers,vps,dedicated-server,shared-hosting,services,free-offers-and-stuff,must-see-deals-，D36）
HTTP_TIMEOUT=                 # 秒（20）
FX_HTTP_TIMEOUT=              # 秒（30）
HTTPS_PROXY=                  # 开发与生产默认不需要（D08）
# SITE_URL 留空（本机地址）时 UA 里是 127.0.0.1，Hostinger 等站的 Cloudflare 会拦（11-07 实测 403），上线前务必填真实地址
USER_AGENT=                   # 应含站名与联系邮箱（Mozilla/5.0 (compatible; BFRadar/0.1; +SITE_URL; CONTACT_EMAIL)）

# ---- 手动刷新：必须设置才允许 POST /api/refresh
REFRESH_TOKEN=

# ---- LLM（OpenAI 兼容接口，D07）：三项齐全才启用，否则纯规则模式
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONCURRENCY=              # （3）
LLM_TIMEOUT=                  # 单次请求超时秒数（120）

# ---- 汇率
FX_PROVIDER=                  # 按序尝试（ecb,erapi,static）

# ---- 显示时区
DISPLAY_TZ_ZH=                # （Asia/Shanghai）
DISPLAY_TZ_EN=                # （UTC）


LOG_LEVEL=                    # （INFO）
